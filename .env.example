# NEONEX Line Balancing - nur lokal, nicht einchecken oder weitergeben.
# App: Projekt-URL und Publishable Key. Kein Secret-/Service-Role-Key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Datenbank-Einrichtung: Projekt-Referenz und vollstaendige PostgreSQL-URL.
# Supabase > Connect: Direct connection oder Session pooler (Port 5432).
# [YOUR-PASSWORD] durch das Datenbankpasswort ersetzen.
# Sonderzeichen im Passwort URL-kodieren; die gesamte URL in Anfuehrungszeichen setzen.
# Keine Access-/Vercel-Tokens oder separaten Passwortfelder erforderlich.
SUPABASE_PROJECT_REF=
SUPABASE_DB_URL=
