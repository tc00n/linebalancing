# Vorlage: nach .env.local kopieren und ausfüllen. .env.local wird nicht eingecheckt.
# Lokale Werte liefert `npx supabase start` bzw. `npx supabase status`.

# Öffentlich (landet im Browser-Bundle): nur URL und Publishable/Anon-Key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Der Service-Role-/Secret-Key gehört NIEMALS in diese App (siehe 01_ANFORDERUNGEN, Abschnitt 7).
