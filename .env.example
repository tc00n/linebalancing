# Vorlage für .env.local (wird nicht eingecheckt). Erläuterungen zu jedem Wert
# stehen in der lokal angelegten .env.local.

# App (öffentlich, landet im Browser-Bundle): nur URL und Publishable Key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Datenbank-Einrichtung per Supabase-CLI (nie Teil der App)
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=

# Optional: Deployment per Vercel-CLI
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Der Supabase Secret Key / service_role-Key gehört NIEMALS in diese App
# (siehe 01_ANFORDERUNGEN, Abschnitt 7).
